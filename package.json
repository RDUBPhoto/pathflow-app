{
  "name": "pathflow-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/dev-local.mjs",
    "start:demo": "node scripts/dev-local.mjs --seed-demo",
    "start:frontend": "node ./node_modules/@angular/cli/bin/ng.js serve --no-hmr --port 4200 --host 127.0.0.1",
    "start:cloud": "ng serve --proxy-config proxy.conf.json",
    "start:local": "node scripts/dev-local.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:api": "npm --prefix api test",
    "test:workflow:local": "PATHFLOW_WORKFLOW_QA_BASE_URL=http://localhost:7071 node --test api/test/inventory-workflow.test.js",
    "test:unit:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage --progress=false",
    "test:e2e": "npx --no-install playwright test",
    "test:e2e:regression": "npx --no-install playwright test -c playwright.regression.config.ts",
    "test:auth:production": "node scripts/run-production-auth-regression.mjs",
    "test:shop:isolated": "node scripts/run-shop-regression.mjs",
    "test:e2e:hosted": "npx --no-install playwright test -c playwright.hosted.config.ts",
    "test:qa": "node scripts/run-qa.mjs",
    "qa:purge": "node scripts/purge-qa-data.mjs",
    "verify:deploy-output": "node scripts/verify-deploy-output.mjs"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3"
  },
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@angular/router": "22.2.6",
    "@azure/storage-blob": "^12.28.0",
    "@daypilot/daypilot-lite-angular": "^5.3.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@tabler/core": "1.7.4",
    "@tabler/icons": "3.51.0",
    "powerbi-client": "^2.23.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@playwright/test": "^1.58.2",
    "@types/jasmine": "~5.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "playwright": "^1.58.2",
    "typescript": "~6.0.3"
  }
}
