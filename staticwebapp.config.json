{
  "routes": [
    {
      "route": "/login",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/signup",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/register",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/sms-opt-in",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/getRoles",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/widget/lead",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/access",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/brandingUpload",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/brandingUpload/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/quote-response",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/reports",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/reports/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/dashboard",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/customers",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/customers/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/schedule",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/inventory",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/user-settings",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/admin-settings",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/forbidden",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/.auth/*",
      "/assets/*",
      "/*.js",
      "/*.css",
      "/*.map",
      "/*.json",
      "/*.ico",
      "/*.svg",
      "/*.png",
      "/*.jpg",
      "/*.jpeg",
      "/*.webp",
      "/*.txt",
      "/browser/*"
    ]
  }
}
